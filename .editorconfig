root = true

[*]
charset = utf-8
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{cs,csx}]
indent_size = 4

[CodeVerdict.Web/Data/**/*.cs]
charset = utf-8-bom

[CodeVerdict.Web/Data/*.cs]
charset = utf-8-bom

[*.{json,yml,yaml,xml,props,targets,csproj,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = true
